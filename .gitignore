*.pem
*.key

# OS/editor temporary files
.DS_Store
._*
Thumbs.db
.idea/
*.swp
*.swo
*~

# Keep package-lock.json, firebase.json, .firebaserc, rules,
# public/app-config.json and .env.example under version control.
# Firebase web configuration is public; service-account keys are not.
