rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email.lower() in ['minmaung0307@gmail.com', 'panna07@gmail.com']; }
  match /categories/{id} { allow read: if true; allow write: if false; }
  match /recipes/{id} { allow read: if true; allow write: if false; }
  match /recipeNames/{id} { allow read, write: if false; }
  match /requests/{id} { allow read: if signedIn() && (admin() || resource.data.authorId == request.auth.uid); allow write: if false; }
  match /users/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','bio','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.bio is string && request.resource.data.bio.size() <= 500 && request.resource.data.updatedAt == request.time;
   match /favorites/{recipeId} {
    allow read, delete: if signedIn() && request.auth.uid == uid;
    allow create, update: if signedIn() && request.auth.uid == uid && exists(/databases/$(database)/documents/recipes/$(recipeId)) && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
   }
  }
 }
}
